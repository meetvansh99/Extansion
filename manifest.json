{
  "manifest_version": 3,
  "name": "Temp Mail Pro",
  "version": "1.0",
  "description": "Premium Temporary Email and Auto-Fill tool.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.mail.tm/*"
  ]
}